# Google Cloud настройки
GOOGLE_CLOUD_PROJECT_ID=didi-rent
GOOGLE_CLOUD_REGION=us-central1

# Параметры генерации
BASE_STEPS=32
SAMPLE_COUNT=1
ADD_WATERMARK=true
PERSON_GENERATION=allow_adult
SAFETY_SETTING=block_medium_and_above

# Настройки вывода
OUTPUT_MIME_TYPE=image/png
COMPRESSION_QUALITY=75

# Опциональные параметры
# STORAGE_URI=gs://your-bucket/path/
# SEED=12345
