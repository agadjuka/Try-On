BOT_TOKEN=your-telegram-bot-token
GEMINI_API_KEY=your-gemini-api-key

# Gemini image model for Virtual Try-On.
GEMINI_MODEL=gemini-3.1-flash-image
# GEMINI_TRY_ON_PROMPT=The first photo is of a model, the second photo is of clothes. I need you to try the clothes on the model. Generate an image.

# Метаданные: sqlite (рекомендуется для Oracle-деплоя) или firestore (legacy)
DATABASE_BACKEND=sqlite
# Локально: ./data/vyon.db | в Docker на сервере: /code/data/vyon.db (см. volume ./data)
SQLITE_PATH=./data/vyon.db

# Хранилище файлов: oracle (по умолчанию) | gcs
STORAGE_BACKEND=oracle

# Oracle Object Storage (S3-compatible)
ORACLE_S3_ENDPOINT=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
ORACLE_S3_REGION=me-dubai-1
ORACLE_ACCESS_KEY_ID=your-oracle-access-key
ORACLE_SECRET_ACCESS_KEY=your-oracle-secret-key
ORACLE_BUCKET_NAME=your-oracle-bucket

# Legacy Google Cloud settings. Нужны только для STORAGE_BACKEND=gcs
# или DATABASE_BACKEND=firestore.
# GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
# GOOGLE_CLOUD_REGION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GCS_BUCKET_NAME=your-gcs-bucket

FIRESTORE_DATABASE_ID=(default)
TELEGRAM_ADMIN_GROUP_ID=
ADMIN_PANEL_FORWARDING_ENABLED=false
# Только для локального запуска REST API: uvicorn main:app --port 8080
# APP_PORT=8080
