{{- 'vyon-widget.css' | asset_url | stylesheet_tag -}}
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
<script src="https://cdnjs.cloudflare.com/ajax/libs/lottie-web/5.12.2/lottie.min.js"></script>

{% assign product_image_url = product.featured_image | img_url: 'master' %}
<input type="hidden" id="vyon-product-url" value="https:{{ product_image_url }}">

<div id="vyon-container">

  <!-- ── Trigger ── -->
  <button id="vyon-trigger-btn" type="button">
    <span class="mi" style="font-size:16px">auto_fix_high</span>
    Try it on
  </button>

  <div id="vyon-panel">

    <!-- ════════════ UPLOAD ════════════ -->
    <div id="vy-s-upload" class="vy-state vy-active">
      <div class="vy-header">
        <div>
          <h3 class="vy-title">Try it on</h3>
          <p class="vy-sub">{{ product.title }}</p>
        </div>
        <button class="vy-x-btn vy-close" type="button">
          <span class="mi">close</span>
        </button>
      </div>

      <div class="vy-body">
        <div id="vyon-upload-zone">
          <input type="file" id="vyon-file-input" accept="image/png,image/jpeg">
          <div class="vy-up-icon">
            <span class="mi" style="font-size:27px">accessibility_new</span>
            <div class="vy-up-badge">
              <span class="mi" style="font-size:12px">photo_camera</span>
            </div>
          </div>
          <div>
            <p class="vy-up-title">Upload full-length photo</p>
            <p class="vy-up-hint">JPG, PNG — up to 10MB</p>
          </div>
          <button class="vy-pill-btn" type="button">Select File</button>
        </div>

        <div id="vyon-file-preview">
          <div class="vy-thumb">
            <img id="vy-prev-img" src="" alt="">
          </div>
          <div style="flex:1;min-width:0">
            <p class="vy-fname" id="vy-prev-name">—</p>
            <p class="vy-fstat">Ready to process</p>
          </div>
          <button class="vy-del-btn" id="vy-remove-btn" type="button">
            <span class="mi" style="font-size:17px">delete</span>
          </button>
        </div>
        <button class="vy-btn-ghost vy-close" type="button">Cancel</button>
      </div>

      <div class="vy-footer">
        <span class="mi" style="font-size:13px">verified_user</span>
        <span class="vy-footer-txt">Powered by Ketly AI · Private &amp; Secure</span>
      </div>
    </div>

    <!-- ════════════ PROCESSING ════════════ -->
    <div id="vy-s-processing" class="vy-state">
      <div class="vy-header">
        <div>
          <h3 class="vy-title">Processing</h3>
          <p class="vy-sub">{{ product.title }}</p>
        </div>
      </div>

      <div class="vy-body">
        <div class="vy-proc-area">
          <div class="vy-lottie-wrap">
            <div
              id="vyon-processing-lottie"
              data-lottie-src="{{ 'Cosmos.json' | asset_url }}"
              style="width:132px;height:132px;">
            </div>
          </div>
          <p class="vy-proc-title" id="vy-proc-title">Processing your style...</p>
          <p class="vy-proc-hint"  id="vy-proc-hint">Our AI is tailoring the look for you</p>
          <div class="vy-bar"></div>
        </div>
        <button class="vy-btn-ghost" id="vy-cancel-proc" type="button">Cancel</button>
      </div>

      <div class="vy-footer">
        <span class="mi" style="font-size:13px">verified_user</span>
        <span class="vy-footer-txt">Powered by Ketly AI · Private &amp; Secure</span>
      </div>
    </div>

    <!-- ════════════ RESULT ════════════ -->
    <div id="vy-s-result" class="vy-state">
      <div class="vy-header">
        <div>
          <h3 class="vy-title">Your Look</h3>
          <p class="vy-sub">{{ product.title }}</p>
        </div>
        <button class="vy-x-btn vy-close" type="button">
          <span class="mi">close</span>
        </button>
      </div>

      <div class="vy-body">
        <div class="vy-result-badge">
          <div class="vy-result-dot"></div>
          Try-On Complete
        </div>
        <div class="vy-result-wrap">
          <img id="vy-result-img" src="" alt="Your try-on result">
        </div>
        <button class="vy-btn-primary" id="vy-retry-btn" type="button">
          <span class="mi" style="font-size:15px">refresh</span>
          Try Another Photo
        </button>
        <button class="vy-btn-ghost vy-close" type="button">Close</button>
      </div>

      <div class="vy-footer">
        <span class="mi" style="font-size:13px">verified_user</span>
        <span class="vy-footer-txt">Powered by Ketly AI · Private &amp; Secure</span>
      </div>
    </div>

    <!-- ════════════ ERROR ════════════ -->
    <div id="vy-s-error" class="vy-state">
      <div class="vy-header">
        <div>
          <h3 class="vy-title">Oops</h3>
          <p class="vy-sub">Something went wrong</p>
        </div>
        <button class="vy-x-btn vy-close" type="button">
          <span class="mi">close</span>
        </button>
      </div>

      <div class="vy-body">
        <div class="vy-err-area">
          <span class="mi" style="font-size:34px;color:#b0b0b0">error_outline</span>
          <p class="vy-err-title" id="vy-err-msg">An error occurred</p>
          <p class="vy-err-hint">Please check your photo and try again</p>
          <button class="vy-btn-primary" id="vy-retry-err-btn" type="button" style="margin-top:14px">
            Try Again
          </button>
        </div>
        <button class="vy-btn-ghost vy-close" type="button">Close</button>
      </div>

      <div class="vy-footer">
        <span class="mi" style="font-size:13px">verified_user</span>
        <span class="vy-footer-txt">Powered by Ketly AI · Private &amp; Secure</span>
      </div>
    </div>

  </div><!-- /vyon-panel -->
</div><!-- /vyon-container -->

{{- 'vyon-widget.js' | asset_url | script_tag -}}

{% schema %}
{
  "name": "VYON Try-On Button",
  "target": "section",
  "templates": ["product"]
}
{% endschema %}
