<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>

<style>
  #vyon-container {
    --vy-black: #000;
    --vy-white: #fff;
    --vy-g50:  #f8f8f8;
    --vy-g100: #f0f0f0;
    --vy-g200: #e0e0e0;
    --vy-g400: #a0a0a0;
    --vy-g500: #707070;
    --vy-r-sm: 14px;
    --vy-r-md: 20px;
    --vy-r-lg: 28px;
    --vy-r-xl: 32px;
    --vy-font: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    font-family: var(--vy-font);
    position: relative;
    margin: 12px 0;
  }

  /* ── Trigger Button ── */
  #vyon-trigger-btn {
    width: 100%; display: flex; align-items: center; justify-content: center;
    gap: 8px; padding: 14px 20px;
    background: var(--vy-black); color: var(--vy-white);
    border: none; border-radius: var(--vy-r-sm); cursor: pointer;
    font-family: var(--vy-font); font-size: 11px; font-weight: 600;
    letter-spacing: 0.14em; text-transform: uppercase;
    transition: background .2s, transform .15s;
  }
  #vyon-trigger-btn:hover { background: #1a1a1a; transform: translateY(-1px); }
  #vyon-trigger-btn:active { transform: translateY(0); }

  /* ── Panel ── */
  #vyon-panel {
    display: none; margin-top: 8px;
    background: var(--vy-white); border-radius: var(--vy-r-xl);
    border: 1px solid var(--vy-g200); overflow: hidden;
    box-shadow: 0 12px 48px rgba(0,0,0,.13), 0 2px 8px rgba(0,0,0,.06);
    animation: vySlideDown .28s cubic-bezier(.34,1.56,.64,1);
  }
  #vyon-panel.vy-visible { display: block; }

  @keyframes vySlideDown {
    from { opacity: 0; transform: translateY(-10px) scale(.98); }
    to   { opacity: 1; transform: translateY(0)   scale(1);    }
  }

  /* ── States ── */
  .vy-state { display: none; }
  .vy-state.vy-active { display: block; }

  /* ── Header ── */
  .vy-header {
    display: flex; justify-content: space-between; align-items: flex-start;
    padding: 24px 24px 0;
  }
  .vy-title  { font-size: 22px; font-weight: 300; color: var(--vy-black); letter-spacing: -.02em; margin: 0; }
  .vy-sub    { font-size: 9px; font-weight: 600; color: var(--vy-g500); letter-spacing: .14em; text-transform: uppercase; margin: 4px 0 0; }
  .vy-x-btn  {
    background: none; border: none; cursor: pointer; padding: 4px;
    color: var(--vy-g400); border-radius: 50%; display: flex;
    transition: background .15s, color .15s;
  }
  .vy-x-btn:hover { background: var(--vy-g100); color: var(--vy-black); }

  /* ── Body ── */
  .vy-body { padding: 18px 24px; }

  /* ── Upload zone ── */
  #vyon-upload-zone {
    border: 1.5px dashed var(--vy-g200); border-radius: var(--vy-r-lg);
    padding: 30px 16px; display: flex; flex-direction: column;
    align-items: center; gap: 14px; cursor: pointer; position: relative;
    transition: background .2s, border-color .2s;
  }
  #vyon-upload-zone:hover { background: var(--vy-g50); border-color: var(--vy-g400); }
  #vyon-file-input {
    position: absolute; inset: 0; width: 100%; height: 100%;
    opacity: 0; cursor: pointer;
  }
  .vy-up-icon {
    width: 62px; height: 62px; background: var(--vy-g50);
    border: 1.5px solid var(--vy-black); border-radius: 50%;
    display: flex; align-items: center; justify-content: center; position: relative;
  }
  .vy-up-badge {
    position: absolute; bottom: -3px; right: -3px;
    width: 22px; height: 22px; background: var(--vy-white);
    border: 1px solid var(--vy-g200); border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
  }
  .vy-up-title { font-size: 10px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--vy-black); margin: 0 0 3px; text-align: center; }
  .vy-up-hint  { font-size: 10px; color: var(--vy-g400); margin: 0; text-align: center; }
  .vy-pill-btn {
    padding: 7px 18px; border: 1.5px solid var(--vy-black);
    border-radius: 50px; background: transparent; color: var(--vy-black);
    font-family: var(--vy-font); font-size: 9px; font-weight: 700;
    letter-spacing: .12em; text-transform: uppercase; cursor: pointer;
    transition: background .2s, color .2s; position: relative; z-index: 1;
  }
  .vy-pill-btn:hover { background: var(--vy-black); color: var(--vy-white); }

  /* ── File preview ── */
  #vyon-file-preview {
    display: none; margin-top: 10px; padding: 11px 13px;
    background: var(--vy-g50); border-radius: var(--vy-r-sm);
    border: 1px solid var(--vy-g100); align-items: center; gap: 11px;
  }
  #vyon-file-preview.vy-visible { display: flex; }
  .vy-thumb { width: 38px; height: 38px; border-radius: 8px; overflow: hidden; background: var(--vy-g200); flex-shrink: 0; }
  .vy-thumb img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(20%); }
  .vy-fname { font-size: 9px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--vy-black); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin: 0 0 2px; }
  .vy-fstat { font-size: 9px; color: var(--vy-g400); margin: 0; }
  .vy-del-btn { background: none; border: none; cursor: pointer; padding: 3px; color: var(--vy-g400); display: flex; transition: color .15s; flex-shrink: 0; }
  .vy-del-btn:hover { color: var(--vy-black); }

  /* ── Buttons ── */
  .vy-btn-primary {
    width: 100%; display: flex; align-items: center; justify-content: center;
    gap: 8px; padding: 15px; background: var(--vy-black); color: var(--vy-white);
    border: none; border-radius: var(--vy-r-sm); cursor: pointer;
    font-family: var(--vy-font); font-size: 10px; font-weight: 700;
    letter-spacing: .15em; text-transform: uppercase;
    transition: background .2s, transform .15s; margin-top: 14px;
  }
  .vy-btn-primary:hover:not(:disabled) { background: #1a1a1a; transform: translateY(-1px); }
  .vy-btn-primary:disabled { opacity: .45; cursor: not-allowed; }
  .vy-btn-ghost {
    width: 100%; background: none; border: none; cursor: pointer;
    font-family: var(--vy-font); font-size: 9px; font-weight: 600;
    letter-spacing: .12em; text-transform: uppercase; color: var(--vy-g400);
    padding: 8px; transition: color .15s; margin-top: 2px;
  }
  .vy-btn-ghost:hover { color: var(--vy-black); }

  /* ── Processing ── */
  .vy-proc-area {
    display: flex; flex-direction: column; align-items: center;
    padding: 32px 16px; background: var(--vy-g50); border-radius: var(--vy-r-lg);
    border: 1px solid var(--vy-g100); position: relative; overflow: hidden;
  }
  .vy-spin-wrap { width: 96px; height: 96px; position: relative; display: flex; align-items: center; justify-content: center; }
  .vy-spin-ring {
    position: absolute; inset: 0; border-radius: 50%;
    border: 2px solid var(--vy-g200); border-top-color: var(--vy-black);
    animation: vySpin 1.1s linear infinite;
  }
  @keyframes vySpin { to { transform: rotate(360deg); } }
  .vy-spin-icon {
    width: 52px; height: 52px; background: var(--vy-white); border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    border: 1px solid var(--vy-g200); z-index: 1;
  }
  .vy-proc-title { font-size: 15px; font-weight: 500; color: var(--vy-black); margin: 14px 0 3px; text-align: center; }
  .vy-proc-hint  { font-size: 11px; color: var(--vy-g400); text-align: center; margin: 0; }
  .vy-bar { position: absolute; bottom: 0; left: 0; right: 0; height: 2px; background: var(--vy-g200); overflow: hidden; }
  .vy-bar::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(90deg, transparent, rgba(0,0,0,.25), transparent);
    animation: vyShimmer 1.8s infinite;
  }
  @keyframes vyShimmer { 0% { transform: translateX(-100%); } 100% { transform: translateX(100%); } }

  /* ── Result ── */
  .vy-result-badge { display: flex; align-items: center; gap: 6px; font-size: 9px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--vy-black); margin-bottom: 10px; }
  .vy-result-dot   { width: 6px; height: 6px; border-radius: 50%; background: var(--vy-black); }
  .vy-result-wrap  { border-radius: var(--vy-r-md); overflow: hidden; background: var(--vy-g100); }
  .vy-result-wrap img { width: 100%; display: block; }

  /* ── Error ── */
  .vy-err-area { padding: 28px 16px; background: var(--vy-g50); border-radius: var(--vy-r-lg); border: 1px solid var(--vy-g100); text-align: center; }
  .vy-err-title { font-size: 13px; font-weight: 500; color: var(--vy-black); margin: 8px 0 4px; }
  .vy-err-hint  { font-size: 11px; color: var(--vy-g400); margin: 0 0 0; }

  /* ── Footer ── */
  .vy-footer {
    padding: 13px 24px; background: var(--vy-g50); border-top: 1px solid var(--vy-g100);
    display: flex; align-items: center; justify-content: center; gap: 6px;
  }
  .vy-footer-txt { font-size: 9px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--vy-g400); }

  /* ── Material icon helper ── */
  .mi {
    font-family: 'Material Symbols Outlined'; font-weight: normal; font-style: normal;
    font-size: 20px; line-height: 1; letter-spacing: normal; text-transform: none;
    display: inline-block; white-space: nowrap; direction: ltr;
    font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
  }
  .mi-fill { font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
</style>

<input type="hidden" id="vyon-product-url" value="https:{{ product.featured_image | img_url: 'master' }}">

<div id="vyon-container">

  <button id="vyon-trigger-btn">
    <span class="mi" style="font-size:16px">auto_fix_high</span>
    Try it on
  </button>

  <div id="vyon-panel">

    <!-- ═══ UPLOAD ═══ -->
    <div id="vy-s-upload" class="vy-state vy-active">
      <div class="vy-header">
        <div>
          <h3 class="vy-title">Try it on</h3>
          <p class="vy-sub">{{ product.title }}</p>
        </div>
        <button class="vy-x-btn vy-close"><span class="mi">close</span></button>
      </div>
      <div class="vy-body">
        <div id="vyon-upload-zone">
          <input type="file" id="vyon-file-input" accept="image/png,image/jpeg">
          <div class="vy-up-icon">
            <span class="mi" style="font-size:27px">accessibility_new</span>
            <div class="vy-up-badge"><span class="mi" style="font-size:12px">photo_camera</span></div>
          </div>
          <div>
            <p class="vy-up-title">Upload full-length photo</p>
            <p class="vy-up-hint">JPG, PNG — up to 10MB</p>
          </div>
          <button class="vy-pill-btn" type="button">Select File</button>
        </div>

        <div id="vyon-file-preview">
          <div class="vy-thumb"><img id="vy-prev-img" src="" alt=""></div>
          <div style="flex:1;min-width:0">
            <p class="vy-fname" id="vy-prev-name">—</p>
            <p class="vy-fstat">Ready to process</p>
          </div>
          <button class="vy-del-btn" id="vy-remove-btn" type="button">
            <span class="mi" style="font-size:17px">delete</span>
          </button>
        </div>

        <button class="vy-btn-primary" id="vyon-submit-btn" type="button">
          <span class="mi mi-fill" style="font-size:15px">auto_fix_high</span>
          Start Try-On
        </button>
        <button class="vy-btn-ghost vy-close">Cancel</button>
      </div>
      <div class="vy-footer">
        <span class="mi" style="font-size:13px">verified_user</span>
        <span class="vy-footer-txt">Powered by Vyon AI · Private &amp; Secure</span>
      </div>
    </div>

    <!-- ═══ PROCESSING ═══ -->
    <div id="vy-s-processing" class="vy-state">
      <div class="vy-header">
        <div>
          <h3 class="vy-title">Processing</h3>
          <p class="vy-sub">{{ product.title }}</p>
        </div>
      </div>
      <div class="vy-body">
        <div class="vy-proc-area">
          <div class="vy-spin-wrap">
            <div class="vy-spin-ring"></div>
            <div class="vy-spin-icon">
              <span class="mi mi-fill" style="font-size:22px">style</span>
            </div>
          </div>
          <p class="vy-proc-title">Processing your style...</p>
          <p class="vy-proc-hint">Our AI is tailoring the look for you</p>
          <div class="vy-bar"></div>
        </div>
        <button class="vy-btn-ghost" id="vy-cancel-proc">Cancel</button>
      </div>
      <div class="vy-footer">
        <span class="mi" style="font-size:13px">verified_user</span>
        <span class="vy-footer-txt">Powered by Vyon AI · Private &amp; Secure</span>
      </div>
    </div>

    <!-- ═══ RESULT ═══ -->
    <div id="vy-s-result" class="vy-state">
      <div class="vy-header">
        <div>
          <h3 class="vy-title">Your Look</h3>
          <p class="vy-sub">{{ product.title }}</p>
        </div>
        <button class="vy-x-btn vy-close"><span class="mi">close</span></button>
      </div>
      <div class="vy-body">
        <div class="vy-result-badge">
          <div class="vy-result-dot"></div>
          Try-On Complete
        </div>
        <div class="vy-result-wrap">
          <img id="vy-result-img" src="" alt="Your try-on result">
        </div>
        <button class="vy-btn-primary" id="vy-retry-btn" type="button">
          <span class="mi" style="font-size:15px">refresh</span>
          Try Another Photo
        </button>
        <button class="vy-btn-ghost vy-close">Close</button>
      </div>
      <div class="vy-footer">
        <span class="mi" style="font-size:13px">verified_user</span>
        <span class="vy-footer-txt">Powered by Vyon AI · Private &amp; Secure</span>
      </div>
    </div>

    <!-- ═══ ERROR ═══ -->
    <div id="vy-s-error" class="vy-state">
      <div class="vy-header">
        <div>
          <h3 class="vy-title">Oops</h3>
          <p class="vy-sub">Something went wrong</p>
        </div>
        <button class="vy-x-btn vy-close"><span class="mi">close</span></button>
      </div>
      <div class="vy-body">
        <div class="vy-err-area">
          <span class="mi" style="font-size:34px;color:#b0b0b0">error_outline</span>
          <p class="vy-err-title" id="vy-err-msg">An error occurred</p>
          <p class="vy-err-hint">Please check your photo and try again</p>
          <button class="vy-btn-primary" id="vy-retry-err-btn" type="button" style="margin-top:14px">
            Try Again
          </button>
        </div>
        <button class="vy-btn-ghost vy-close">Close</button>
      </div>
      <div class="vy-footer">
        <span class="mi" style="font-size:13px">verified_user</span>
        <span class="vy-footer-txt">Powered by Vyon AI · Private &amp; Secure</span>
      </div>
    </div>

  </div><!-- /panel -->
</div><!-- /container -->

<script>
(function () {
  var STATES = ['upload', 'processing', 'result', 'error'];
  var $ = function (id) { return document.getElementById(id); };
  var currentFile = null;
  var pollId = null;

  function showState(name) {
    STATES.forEach(function (s) {
      var el = $('vy-s-' + s);
      if (el) el.classList.toggle('vy-active', s === name);
    });
  }

  function openPanel() {
    var p = $('vyon-panel');
    if (p) { p.classList.add('vy-visible'); showState('upload'); }
  }

  function closePanel() {
    var p = $('vyon-panel');
    if (p) p.classList.remove('vy-visible');
    if (pollId) { clearInterval(pollId); pollId = null; }
  }

  function resetUpload() {
    currentFile = null;
    var fi = $('vyon-file-input');
    if (fi) fi.value = '';
    var fp = $('vyon-file-preview');
    if (fp) fp.classList.remove('vy-visible');
    showState('upload');
  }

  function setPreview(file) {
    currentFile = file;
    var fp = $('vyon-file-preview');
    var nm = $('vy-prev-name');
    var im = $('vy-prev-img');
    if (!fp || !nm) return;
    nm.textContent = file.name.toUpperCase();
    var r = new FileReader();
    r.onload = function (e) { if (im) im.src = e.target.result; };
    r.readAsDataURL(file);
    fp.classList.add('vy-visible');
  }

  function showError(msg) {
    var m = $('vy-err-msg');
    if (m) m.textContent = msg || 'An error occurred';
    showState('error');
  }

  async function startTryOn() {
    if (!currentFile) { alert('Please upload a photo first.'); return; }
    var gu = $('vyon-product-url');
    var garmentUrl = gu ? gu.value : '';
    if (!garmentUrl) { showError('Could not determine product image URL.'); return; }

    showState('processing');

    try {
      var fd = new FormData();
      fd.append('model', currentFile);
      fd.append('garment_url_1', garmentUrl);

      var res = await fetch('/apps/vyon-api/api/proxy', { method: 'POST', body: fd });
      if (!res.ok) throw new Error('Failed to create task: ' + res.status);

      var data = await res.json();
      var taskId = data.task_id;
      if (!taskId) throw new Error('No task ID received from server');

      var attempts = 0;
      pollId = setInterval(async function () {
        attempts++;
        if (attempts > 30) {
          clearInterval(pollId); pollId = null;
          showError('Request timed out. Please try again later.');
          return;
        }
        try {
          var sr = await fetch('/apps/vyon-api/api/proxy?task_id=' + encodeURIComponent(taskId));
          if (!sr.ok) throw new Error('Status check failed: ' + sr.status);
          var sd = await sr.json();
          if (sd.status === 'completed') {
            clearInterval(pollId); pollId = null;
            var img = (sd.results || [])[0];
            if (!img) { showError('Task completed but no result image found.'); return; }
            var ri = $('vy-result-img');
            if (ri) ri.src = img;
            showState('result');
          } else if (sd.status === 'failed') {
            clearInterval(pollId); pollId = null;
            showError(sd.error || 'Processing failed. Please try again.');
          }
        } catch (pe) {
          clearInterval(pollId); pollId = null;
          showError(pe.message || 'Connection error');
        }
      }, 4000);

    } catch (e) {
      showError(e.message || 'An unexpected error occurred');
    }
  }

  // ── Bind events ──
  var trigger = $('vyon-trigger-btn');
  if (trigger) trigger.addEventListener('click', openPanel);

  document.querySelectorAll('#vyon-panel .vy-close').forEach(function (btn) {
    btn.addEventListener('click', closePanel);
  });

  var fi = $('vyon-file-input');
  if (fi) fi.addEventListener('change', function (e) {
    var f = e.target.files && e.target.files[0];
    if (f) setPreview(f);
  });

  var delBtn = $('vy-remove-btn');
  if (delBtn) delBtn.addEventListener('click', function (e) {
    e.stopPropagation(); resetUpload();
  });

  var submitBtn = $('vyon-submit-btn');
  if (submitBtn) submitBtn.addEventListener('click', startTryOn);

  var retryBtn = $('vy-retry-btn');
  if (retryBtn) retryBtn.addEventListener('click', resetUpload);

  var retryErrBtn = $('vy-retry-err-btn');
  if (retryErrBtn) retryErrBtn.addEventListener('click', resetUpload);

  var cancelProc = $('vy-cancel-proc');
  if (cancelProc) cancelProc.addEventListener('click', function () {
    if (pollId) { clearInterval(pollId); pollId = null; }
    closePanel();
  });
})();
</script>

{% schema %}
{
  "name": "VYON Try-On Button",
  "target": "section",
  "templates": ["product"]
}
{% endschema %}
